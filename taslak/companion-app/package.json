{
  "name": "deepslide-local-ai",
  "version": "1.0.0",
  "description": "DeepSlide Local AI — Ollama companion app for running AI models locally",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "electron-ollama": "^0.1.25",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.deepslide.local-ai",
    "productName": "DeepSlide Local AI",
    "copyright": "Copyright © 2025 DeepSlide",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "dmg": {
      "title": "DeepSlide Local AI",
      "contents": [
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 130, "y": 150, "type": "file" }
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico"
    },
    "linux": {
      "icon": "assets/icons/",
      "category": "Utility",
      "target": ["AppImage", "deb"]
    },
    "publish": {
      "provider": "github",
      "owner": "deepslide",
      "repo": "local-ai-releases"
    }
  }
}
